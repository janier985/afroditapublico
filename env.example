:root{--bg:#fffafc;--card:#fff;--soft:#f8f2fb;--text:#2d1f27;--muted:#75657b;--line:#eadff0;--primary:#b58ad8;--primaryDark:#9867bf;--shadow:0 14px 38px rgba(66,23,44,.09)}*{box-sizing:border-box}html,body,#root{margin:0;min-height:100%}body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:radial-gradient(circle at top left,#fff 0%,var(--bg) 42%,#f7f1fb 100%);color:var(--text)}a{color:inherit}.shell{width:min(1180px,100%);margin:0 auto;padding:18px}.center{min-height:100vh;display:grid;place-items:center}.hero{display:grid;grid-template-columns:120px minmax(0,1fr);gap:18px;align-items:center;background:linear-gradient(135deg,#fff 0%,#fbf6ff 100%);border:1px solid var(--line);border-radius:28px;padding:22px;box-shadow:var(--shadow)}.brand{width:120px;height:76px;border-radius:22px;display:grid;place-items:center;background:#fff;border:1px solid var(--line);overflow:hidden}.brand img{width:100%;height:100%;object-fit:contain;padding:8px}.brandFallback{color:var(--primaryDark);font-weight:900}.hero small{display:block;color:var(--primaryDark);font-size:11px;text-transform:uppercase;letter-spacing:.16em;font-weight:900;margin-bottom:6px}.hero h1{margin:0;font-size:clamp(28px,5vw,44px);line-height:1;letter-spacing:-.05em}.hero p{max-width:720px;margin:10px 0 0;color:var(--muted);line-height:1.65}.filters{margin-top:18px;background:#fff;border:1px solid var(--line);border-radius:24px;padding:14px;box-shadow:var(--shadow)}.filters input{width:100%;height:52px;border-radius:16px;border:1px solid var(--line);padding:0 16px;font:inherit;outline:none;color:var(--text)}.filters input:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(181,138,216,.14)}.chips{display:flex;gap:9px;overflow:auto;padding-top:12px;scrollbar-width:none}.chips::-webkit-scrollbar{display:none}.chips button{border:1px solid var(--line);background:#fff;color:#675774;border-radius:999px;padding:10px 14px;white-space:nowrap;font-weight:850;cursor:pointer}.chips button.active{background:linear-gradient(180deg,var(--primary),var(--primaryDark));color:#fff;border-color:transparent}.count{margin:18px 2px 12px;color:var(--muted);font-size:13px;font-weight:850}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:24px;overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column}.imageWrap{aspect-ratio:1/1;background:var(--soft);overflow:hidden}.imageWrap img{width:100%;height:100%;object-fit:cover;display:block}.imageFallback{width:100%;height:100%;display:grid;place-items:center;color:#9b8aa8;font-weight:900}.cardBody{padding:14px;display:flex;flex-direction:column;gap:10px;flex:1}.meta{color:var(--primaryDark);font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:950}.card h2{margin:0;font-size:16px;line-height:1.25}.card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.variants{border:1px solid var(--line);background:var(--soft);border-radius:16px;padding:10px;color:var(--muted);font-size:12px;line-height:1.45}.variants strong{display:block;color:var(--text);margin-bottom:4px}.actions{display:grid;gap:8px;margin-top:auto}.actions a{min-height:42px;display:flex;align-items:center;justify-content:center;border-radius:999px;text-decoration:none;font-size:13px;font-weight:950}.primary{background:linear-gradient(180deg,var(--primary),var(--primaryDark));color:#fff}.ghost{background:#fff;border:1px solid var(--line);color:#675774}.loaderCard,.emptyCard{background:#fff;border:1px solid var(--line);border-radius:24px;padding:28px;text-align:center;box-shadow:var(--shadow)}.loaderCard strong,.emptyCard strong{display:block;font-size:20px;margin-bottom:8px}.loaderCard span,.emptyCard p{margin:0;color:var(--muted);line-height:1.6}.spinner{width:44px;height:44px;border-radius:50%;border:4px solid #f2e8f8;border-top-color:var(--primary);margin:0 auto 16px;animation:spin .9s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:980px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:720px){.shell{padding:12px}.hero{grid-template-columns:1fr;border-radius:22px;padding:18px}.brand{width:110px;height:70px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{border-radius:20px}.cardBody{padding:11px}.actions a{font-size:12px}}